{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LegalKural Weekly Journal Archive Entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "journal_id",
    "edition_date",
    "covered_date_range",
    "article_count",
    "selected_case_ids",
    "manifest_sha256",
    "assembly_sha256",
    "pdf_sha256",
    "renderer_version",
    "verification_status",
    "archived_at_utc",
    "paths",
    "archive_entry_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "journal_id": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9._-]+$"
    },
    "edition_date": {
      "type": "string",
      "format": "date"
    },
    "covered_date_range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": {"type": "string", "format": "date"},
        "end": {"type": "string", "format": "date"}
      }
    },
    "article_count": {
      "type": "integer",
      "minimum": 1
    },
    "selected_case_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "assembly_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "pdf_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "renderer_version": {"enum": ["1.0.0", "2.0.0"]},
    "verification_status": {"const": "VERIFIED"},
    "archived_at_utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edition",
        "manifest",
        "assembly",
        "pdf",
        "evidence"
      ],
      "properties": {
        "edition": {"type": "string", "minLength": 1},
        "manifest": {"type": "string", "minLength": 1},
        "assembly": {"type": "string", "minLength": 1},
        "pdf": {"type": "string", "minLength": 1},
        "evidence": {"type": "string", "minLength": 1}
      }
    },
    "archive_entry_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
