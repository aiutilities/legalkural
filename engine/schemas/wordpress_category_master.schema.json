{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LegalKural WordPress Category Master",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "version",
    "frozen_at",
    "governance",
    "categories"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "status": {"type": "string", "const": "FROZEN"},
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "frozen_at": {"type": "string", "format": "date"},
    "governance": {
      "type": "object",
      "required": [
        "selection_rule",
        "ai_generation_allowed",
        "editor_override_allowed",
        "change_policy"
      ],
      "properties": {
        "selection_rule": {"type": "string", "const": "EXACTLY_ONE"},
        "ai_generation_allowed": {"type": "boolean", "const": false},
        "editor_override_allowed": {"type": "boolean", "const": true},
        "change_policy": {
          "type": "string",
          "const": "VERSIONED_MIGRATION_ONLY"
        }
      },
      "additionalProperties": false
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "additionalProperties": false
}
