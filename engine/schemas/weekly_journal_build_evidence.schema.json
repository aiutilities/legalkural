{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LegalKural Weekly Journal Build Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "journal_id",
    "edition_date",
    "status",
    "selected_by",
    "finalized_at_utc",
    "selected_case_ids",
    "article_count",
    "manifest_sha256",
    "assembly_sha256",
    "pdf_sha256",
    "pdf_page_count",
    "pdf_byte_count",
    "language",
    "tamil_rendered",
    "thirukkural_algorithm_usage",
    "provider_requests",
    "wordpress_requests",
    "files",
    "evidence_sha256",
    "renderer_version"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "journal_id": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9._-]+$"
    },
    "edition_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "const": "COMPLETE"
    },
    "selected_by": {
      "type": "string",
      "minLength": 1
    },
    "finalized_at_utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "selected_case_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "article_count": {
      "type": "integer",
      "minimum": 1
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "assembly_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "pdf_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "pdf_page_count": {
      "type": "integer",
      "minimum": 1
    },
    "pdf_byte_count": {
      "type": "integer",
      "minimum": 1
    },
    "language": {
      "const": "en"
    },
    "tamil_rendered": {
      "const": false
    },
    "thirukkural_algorithm_usage": {
      "const": "TITLE_ONLY"
    },
    "provider_requests": {
      "const": 0
    },
    "wordpress_requests": {
      "const": 0
    },
    "files": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest",
        "assembly",
        "pdf",
        "evidence"
      ],
      "properties": {
        "manifest": {
          "const": "manifest.json"
        },
        "assembly": {
          "const": "assembly.json"
        },
        "pdf": {
          "const": "journal.pdf"
        },
        "evidence": {
          "const": "build-evidence.json"
        }
      }
    },
    "evidence_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "renderer_version": {
      "const": "1.0.0"
    }
  }
}
