{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version","document_id","document_type","title","original_filename","original_format","conversion_status","approval_status","sha256","uploaded_by","uploaded_at"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "document_id": {"type": "string", "minLength": 1},
    "document_type": {"enum": ["JUDGMENT","GOVERNMENT_ORDER","CIRCULAR","REPORT","ANNEXURE","SPREADSHEET","OTHER"]},
    "title": {"type": "string", "minLength": 1},
    "original_filename": {"type": "string", "minLength": 1},
    "published_filename": {"type": ["string","null"]},
    "original_format": {"enum": ["PDF","DOC","DOCX","XLS","XLSX","CSV"]},
    "conversion_status": {"enum": ["NOT_REQUIRED","PENDING","CONVERTED","FAILED"]},
    "approval_status": {"enum": ["DRAFT","APPROVED","PUBLISHED","WITHDRAWN"]},
    "source_authority": {"type": ["string","null"]},
    "document_date": {"type": ["string","null"], "format": "date"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "uploaded_by": {"type": "string", "minLength": 1},
    "uploaded_at": {"type": "string", "format": "date-time"},
    "pdf_path": {"type": ["string","null"]},
    "download_url": {"type": ["string","null"], "format": "uri"},
    "qr_path": {"type": ["string","null"]},
    "page_count": {"type": ["integer","null"], "minimum": 1}
  },
  "additionalProperties": false
}
