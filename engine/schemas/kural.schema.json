{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LegalKural Title Editorial Brief",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "reference_case_id",
    "status",
    "compressed_title",
    "human_conflict",
    "legal_holding",
    "universal_principle",
    "thirukkural_algorithm_usage",
    "tamil_rendered",
    "editorial_boundary",
    "source_traceability",
    "quality_notes",
    "requires_human_editorial_review"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "reference_case_id": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "compressed_title": {
      "type": "string",
      "minLength": 1
    },
    "human_conflict": {
      "type": "string"
    },
    "legal_holding": {
      "type": "string"
    },
    "universal_principle": {
      "type": "string"
    },
    "thirukkural_algorithm_usage": {
      "const": "TITLE_ONLY"
    },
    "tamil_rendered": {
      "const": false
    },
    "editorial_boundary": {
      "type": "string"
    },
    "source_traceability": {
      "type": "array"
    },
    "quality_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requires_human_editorial_review": {
      "type": "boolean"
    }
  }
}
