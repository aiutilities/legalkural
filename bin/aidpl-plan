#!/usr/bin/env python3
from __future__ import annotations

import json
from pathlib import Path

root = Path(__file__).resolve().parent.parent
registry = json.loads(
    (root / "AIDPL/AGENT_REGISTRY.json").read_text(encoding="utf-8")
)

print("=" * 64)
print("LEGAL KURAL AIDPL AGENT PLAN")
print("=" * 64)
print(f"Orchestrator: {registry['orchestrator']}")
print()

for index, agent in enumerate(registry["agents"], start=1):
    print(f"{index:02d}. {agent['name']} [{agent['id']}]")
    print(f"    Owns: {', '.join(agent['owns'])}")
    print(f"    Outputs: {', '.join(agent['outputs'])}")

print("=" * 64)
